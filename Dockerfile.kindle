# syntax=docker/dockerfile:1
# A native Linux builder (amd64 or arm64) that cross-compiles PW2-compatible
# ARMEL binaries. The target is always armv7-unknown-linux-gnueabi.
FROM debian:trixie-slim

ARG ANKI_COMMIT=666c2c64d4a1772c03948f5b667438da63ddaa76
ARG PROTOC_VERSION=29.3
ARG RUST_TOOLCHAIN=1.92.0

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    KINDLE_SDK_ROOT=/opt/ankink-sdk \
    PROTOC=/usr/local/bin/protoc

RUN apt-get update >/dev/null && apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        cmake \
        curl \
        file \
        g++-arm-linux-gnueabi \
        gcc-arm-linux-gnueabi \
        git \
        libc6-dev-armel-cross \
        make \
        ninja-build \
        pkg-config \
        qemu-user \
        unzip \
        util-linux \
    >/dev/null && rm -rf /var/lib/apt/lists/*

# Pin protoc to the version used by the Anki backend build.
RUN case "$(dpkg --print-architecture)" in \
        amd64) protoc_arch=x86_64 ;; \
        arm64) protoc_arch=aarch_64 ;; \
        *) echo "Unsupported Docker build architecture" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/protoc.zip \
        "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${protoc_arch}.zip" \
    && unzip -q /tmp/protoc.zip -d /usr/local \
    && rm /tmp/protoc.zip

RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
    && rustup target add armv7-unknown-linux-gnueabi --toolchain "$RUST_TOOLCHAIN"

# Keep the Anki source inside the image: host checkouts remain clean and the
# commit used for the Rust backend is reproducible.
RUN git clone https://github.com/ankitects/anki.git /opt/anki \
    && git -C /opt/anki checkout --detach "$ANKI_COMMIT" \
    && git -C /opt/anki submodule update --init ftl/core-repo ftl/qt-repo \
    && git config --system --add safe.directory /opt/anki

COPY docker/create-sdk.sh /usr/local/bin/create-sdk
RUN create-sdk

COPY docker/entrypoint.sh /usr/local/bin/ankink-docker-entrypoint
COPY docker/build-kindle.sh /usr/local/bin/build-kindle
RUN chmod 755 /usr/local/bin/create-sdk /usr/local/bin/ankink-docker-entrypoint /usr/local/bin/build-kindle

ENTRYPOINT ["/usr/local/bin/ankink-docker-entrypoint"]
