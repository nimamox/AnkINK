# syntax=docker/dockerfile:1
# Shared Kindle development image. It can build C++ Potion and Rust/C++ AnkINK
# while each repository remains standalone and owns its build entrypoint.
FROM debian:trixie-slim

ARG ANKI_COMMIT=666c2c64d4a1772c03948f5b667438da63ddaa76
ARG PROTOC_VERSION=29.3
ARG RUST_TOOLCHAIN=1.92.0
ARG OPENSSL_VERSION=3.0.18
ARG CURL_VERSION=8.16.0

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    KINDLE_SDK_ROOT=/opt/kindle-sdk \
    PROTOC=/usr/local/bin/protoc

RUN apt-get update >/dev/null && apt-get install -y --no-install-recommends \
        ca-certificates build-essential cmake curl file g++-arm-linux-gnueabi \
        g++-arm-linux-gnueabihf gcc-arm-linux-gnueabi gcc-arm-linux-gnueabihf \
        git libc6-dev-armel-cross libc6-dev-armhf-cross make ninja-build perl \
        pkg-config qemu-user unzip util-linux xz-utils \
    >/dev/null && rm -rf /var/lib/apt/lists/*

RUN case "$(dpkg --print-architecture)" in \
        amd64) protoc_arch=x86_64 ;; arm64) protoc_arch=aarch_64 ;; \
        *) echo "Unsupported Docker build architecture" >&2; exit 1 ;; esac \
    && curl -fsSL -o /tmp/protoc.zip \
      "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${protoc_arch}.zip" \
    && unzip -q /tmp/protoc.zip -d /usr/local && rm /tmp/protoc.zip

RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
    && rustup target add armv7-unknown-linux-gnueabi \
         armv7-unknown-linux-gnueabihf --toolchain "$RUST_TOOLCHAIN"

RUN git clone https://github.com/ankitects/anki.git /opt/anki \
    && git -C /opt/anki checkout --detach "$ANKI_COMMIT" \
    && git -C /opt/anki submodule update --init ftl/core-repo ftl/qt-repo \
    && git config --system --add safe.directory /opt/anki

COPY scripts/kindle-abi.sh /usr/local/lib/kindle-abi.sh
COPY docker/create-sdk.sh docker/build-native-deps.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/create-sdk.sh /usr/local/bin/build-native-deps.sh \
    && /usr/local/bin/create-sdk.sh

# Static target TLS/HTTP libraries keep Potion’s Kindle runtime closure small
# and avoid depending on the Kindle firmware’s old SSL stack.
RUN OPENSSL_VERSION="$OPENSSL_VERSION" CURL_VERSION="$CURL_VERSION" \
    /usr/local/bin/build-native-deps.sh

ENTRYPOINT ["/bin/sh", "/workspace/docker/entrypoint.sh"]
